<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AYNA BOOK - Digital FM/AM & Quantum Platform</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --bg-primary: #030712;
            --card-bg: #0b132b;
            --accent-blue: #38bdf8;
            --accent-purple: #8b5cf6;
            --accent-green: #10b981;
        }

        body {
            background-color: var(--bg-primary);
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Strict Aspect Ratio 1:1 for All Modules */
        .square-box {
            aspect-ratio: 1 / 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background-color: var(--card-bg);
            border: 2px solid #1e293b;
            border-radius: 1rem;
            padding: 1.25rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
            transition: all 0.3s ease;
        }

        .square-box:hover {
            border-color: var(--accent-purple);
            transform: translateY(-4px);
            box-shadow: 0 15px 30px -5px rgba(139, 92, 246, 0.3);
        }

        .box-content {
            flex-grow: 1;
            overflow-y: auto;
            margin-top: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .box-content::-webkit-scrollbar {
            width: 4px;
        }
        .box-content::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
    </style>
</head>
<body class="min-h-screen pb-12">

    <!-- Header Section -->
    <header class="bg-gradient-to-r from-slate-950 via-slate-900 to-indigo-950 border-b-4 border-purple-600 py-6 px-4 text-center">
        <h1 class="text-3xl md:text-5xl font-extrabold text-sky-400 tracking-wider">🌍 AYNA BOOK</h1>
        <p class="text-slate-400 text-sm md:text-base mt-1">Global FM/AM Digital Radio & Quantum Tech Matrix</p>
        <p class="text-purple-400 italic text-xs md:text-sm mt-1">Founder: Mohammed Mahabub Alam | "My World. My Story. My AYNA BOOK."</p>
    </header>

    <!-- Global Grid Layout (1:1 Ratio Modules) -->
    <main class="max-w-[1700px] mx-auto px-4 mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

        <!-- 1. Digital FM/AM Radio Player Engine (1:1 Aspect Ratio) -->
        <div class="square-box">
            <h3 class="text-lg font-bold text-sky-400 border-b border-slate-700 pb-2">📻 FM/AM ডিজিটাল রেডিও প্লেয়ার</h3>
            <div class="box-content flex flex-col justify-around text-center">
                <div class="bg-slate-950 p-3 rounded-lg border border-slate-800">
                    <p class="text-xs text-slate-400">বর্তমান ফ্রিকোয়েন্সি</p>
                    <p id="radio-freq-display" class="text-2xl font-mono text-emerald-400 font-bold mt-1">89.6 MHz FM</p>
                    <p id="radio-station-name" class="text-xs text-purple-300 mt-1">রেডিও ফুর্তি (Bangladesh)</p>
                </div>

                <div class="space-y-2 mt-2">
                    <label class="text-xs text-slate-400 block text-left">ফ্রিকোয়েন্সি / স্টেশন নির্বাচন:</label>
                    <select id="radio-select" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-xs text-white">
                        <option value="89.6 FM|রেডিও ফুর্তি|bd">89.6 FM — Radio Foorti (BD)</option>
                        <option value="100.0 FM|বাংলাদেশ বেতার|bd">100.0 FM — Bangladesh Betar (BD)</option>
                        <option value="88.0 AM|NPR News AM|us">880 AM — NPR News Radio (USA)</option>
                        <option value="105.4 FM|BBC World Radio|global">105.4 FM — BBC World Service</option>
                    </select>
                </div>
            </div>
            <button id="btn-toggle-radio" class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-bold py-2 rounded text-sm transition">▶️ প্লে / পজ রেডিও</button>
        </div>

        <!-- 2. Profile & Account Tier (1:1 Aspect Ratio) -->
        <div class="square-box">
            <h3 class="text-lg font-bold text-sky-400 border-b border-slate-700 pb-2">👤 প্রোফাইল ও ৪ টায়ার অ্যাকাউন্ট</h3>
            <div class="box-content text-center flex flex-col items-center">
                <img src="icon-192.png" alt="Profile" class="w-20 h-20 rounded-full border-4 border-purple-500 object-cover mb-2" onerror="this.src='https://via.placeholder.com/100'">
                <p class="font-semibold text-slate-200 text-sm">Mohammed Mahabub Alam</p>
                <div class="w-full mt-1">
                    <select id="acc-tier-select" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-xs text-white">
                        <option value="Personal">১. ব্যক্তিগত (Free)</option>
                        <option value="Business">২. Business ($10 + BDT)</option>
                        <option value="VIP">৩. VIP ($10 + BDT)</option>
                        <option value="VVIP">৪. VVIP ($20 + BDT)</option>
                    </select>
                </div>
                <p class="text-xs text-emerald-400 font-mono mt-2">আন্তর্জাতিক আইডি: <b>01400751906</b></p>
            </div>
            <button id="btn-save-profile" class="w-full bg-gradient-to-r from-sky-500 to-purple-600 hover:from-sky-600 hover:to-purple-700 text-white font-bold py-2 rounded text-sm transition">প্রোফাইল আপডেট</button>
        </div>

        <!-- 3. Messenger & Dual Wallet (1:1 Aspect Ratio) -->
        <div class="square-box">
            <h3 class="text-lg font-bold text-sky-400 border-b border-slate-700 pb-2">💰 মেসেঞ্জার ও ওয়ালেট</h3>
            <div class="box-content">
                <div class="bg-slate-950 p-2 rounded border border-slate-800 mb-2">
                    <p class="text-xs text-emerald-400 font-mono">USD: $<span id="val-usd">2500.00</span></p>
                    <p class="text-xs text-emerald-400 font-mono">BDT: ৳<span id="val-bdt">275000.00</span></p>
                </div>
                <input type="text" id="msg-recipient" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-xs text-white mb-1" placeholder="প্রাপক আইডি / 01400751906">
                <input type="text" id="msg-amount" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-xs text-white" placeholder="মেসেজ বা টাকার পরিমাণ...">
            </div>
            <button id="btn-transfer" class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-bold py-2 rounded text-sm transition">পাঠান</button>
        </div>

        <!-- 4. Weather & Satellite Radar (1:1 Aspect Ratio) -->
        <div class="square-box">
            <h3 class="text-lg font-bold text-sky-400 border-b border-slate-700 pb-2">📡 স্যাটেলাইট ও ওয়েদার রাডার</h3>
            <div class="box-content">
                <div class="w-full h-32 bg-slate-950 rounded border border-slate-800 relative overflow-hidden">
                    <iframe class="w-full h-full border-0" src="https://radar.weather.gov/" title="Radar"></iframe>
                </div>
            </div>
            <button id="btn-refresh-radar" class="w-full bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-600 hover:to-blue-700 text-white font-bold py-2 rounded text-sm transition">রাডার রিফ্রেশ</button>
        </div>

    </main>

    <!-- JavaScript Module Logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            let isRadioPlaying = false;

            // FM/AM Dynamic Radio Switcher
            document.getElementById('radio-select')?.addEventListener('change', (e) => {
                const [freq, station] = e.target.value.split('|');
                document.getElementById('radio-freq-display').innerText = freq;
                document.getElementById('radio-station-name').innerText = station;
            });

            // FM/AM Toggle Play/Pause
            document.getElementById('btn-toggle-radio')?.addEventListener('click', () => {
                isRadioPlaying = !isRadioPlaying;
                const btn = document.getElementById('btn-toggle-radio');
                if (isRadioPlaying) {
                    btn.innerText = "⏸️ রেডিও স্টপ করুন";
                    btn.classList.replace('from-emerald-500', 'from-amber-500');
                    alert("FM/AM রেডিও লাইভ সম্প্রচার প্লে হচ্ছে...");
                } else {
                    btn.innerText = "▶️ প্লে / পজ রেডিও";
                    btn.classList.replace('from-amber-500', 'from-emerald-500');
                    alert("রেডিও স্ট্রিম বন্ধ করা হয়েছে।");
                }
            });

            // Profile Save Action
            document.getElementById('btn-save-profile')?.addEventListener('click', () => {
                const tier = document.getElementById('acc-tier-select').value;
                alert(`আপনার অ্যাকাউন্ট সফলভাবে "${tier}" লেভেলে আপডেট করা হয়েছে!\nআন্তর্জাতিক অ্যাকাউন্ট আইডি: 01400751906`);
            });

            // Transfer Action
            document.getElementById('btn-transfer')?.addEventListener('click', () => {
                const amt = document.getElementById('msg-amount').value;
                if (amt) {
                    alert(`মেসেজ/লেনদেন "${amt}" সফলভাবে সম্পন্ন হয়েছে!`);
                    document.getElementById('msg-amount').value = '';
                } else {
                    alert('দয়া করে কিছু লিখুন।');
                }
            });

            // Radar Refresh
            document.getElementById('btn-refresh-radar')?.addEventListener('click', () => {
                alert('রাডার তথ্য আপডেট করা হয়েছে।');
            });
        });
    </script>
</body>
</html>