rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    // =====================================================
    // COMMON FUNCTIONS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }


    // =====================================================
    // USERS
    // =====================================================

    match /users/{userId} {

      // নিজের Account document তৈরি করতে পারবে
      allow create: if isOwner(userId);

      // শুধু নিজের Account পড়তে পারবে
      allow read: if isOwner(userId);

      // শুধু নিজের Account update করতে পারবে
      allow update: if isOwner(userId);

      // নিজের Account delete করতে পারবে
      allow delete: if isOwner(userId);
    }


    // =====================================================
    // POSTS
    // =====================================================

    match /posts/{postId} {

      // Public posts পড়া যাবে
      allow read: if true;


      // Login করা user নিজের নামে Post তৈরি করতে পারবে
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000;


      // শুধু Post-এর owner update করতে পারবে
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000;


      // শুধু Post-এর owner delete করতে পারবে
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }


    // =====================================================
    // CHAT ROOMS / MESSAGES
    // =====================================================

    match /rooms/{roomId}/messages/{messageId} {

      // Login করা user message পড়তে পারবে
      allow read: if signedIn();


      // Login করা user নিজের UID দিয়ে message তৈরি করতে পারবে
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;


      // Message পরিবর্তন করা যাবে না
      allow update: if false;


      // Message delete করা যাবে না
      allow delete: if false;
    }


    // =====================================================
    // DEFAULT DENY
    // =====================================================

    match /{document=**} {

      allow read, write: if false;
    }

  }
}