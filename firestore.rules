
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {

      // Users can read only their own account.
      allow read: if isOwner(uid);

      // Registration: Personal + Free only.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.accountType == "personal"
        && request.resource.data.plan == "free"
        && request.resource.data.accountStatus == "pending_email_verification"
        && request.resource.data.emailVerified == false
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.photoURL is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          "uid",
          "fullName",
          "email",
          "phone",
          "photoURL",
          "accountType",
          "plan",
          "accountStatus",
          "emailVerified",
          "createdAt",
          "updatedAt"
        ]);

      // Email verification: Firebase token must confirm verification.
      allow update: if isOwner(uid)
        && request.auth.token.email_verified == true
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "emailVerified",
               "accountStatus",
               "updatedAt"
             ])
        && request.resource.data.emailVerified == true
        && request.resource.data.accountStatus == "active"
        && request.resource.data.updatedAt is timestamp;

      // Account deletion must use a trusted server-side process.
      allow delete: if false;
    }

    // Deny access to all other documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
