rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    /* ================================================
       USER PROFILE FILES
       Path:
       users/{userId}/...
       ================================================ */

    match /users/{userId}/{allPaths=**} {

      /*
       * শুধু লগইন করা user নিজের ফাইল
       * upload/read/update/delete করতে পারবে।
       */
      allow read, write: if
        request.auth != null &&
        request.auth.uid == userId;
    }


    /* ================================================
       POSTS
       Path:
       posts/{userId}/...
       ================================================ */

    match /posts/{userId}/{allPaths=**} {

      allow read, write: if
        request.auth != null &&
        request.auth.uid == userId;
    }


    /* ================================================
       EVERYTHING ELSE
       ================================================ */

    /*
     * অন্য কোনো অজানা Storage path
     * ডিফল্টভাবে বন্ধ থাকবে।
     */
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}