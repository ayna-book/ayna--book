rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    // =====================================================
    // AYNA BOOK — USER FILES
    // =====================================================

    match /users/{userId}/{allPaths=**} {

      // নিজের ফাইল নিজে দেখতে পারবে
      allow read:
        if request.auth != null
        && request.auth.uid == userId;


      // নিজের ফাইল upload/update
      allow create, update:
        if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');


      // নিজের ফাইল delete
      allow delete:
        if request.auth != null
        && request.auth.uid == userId;
    }


    // =====================================================
    // AYNA BOOK — POST MEDIA
    // =====================================================

    match /posts/{userId}/{allPaths=**} {

      // নিজের post media দেখতে পারবে
      allow read:
        if request.auth != null
        && request.auth.uid == userId;


      // Image / Video upload
      allow create, update:
        if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 20 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          ||
          request.resource.contentType.matches('video/.*')
        );


      // নিজের post media delete
      allow delete:
        if request.auth != null
        && request.auth.uid == userId;
    }


    // =====================================================
    // DEFAULT DENY
    // =====================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}