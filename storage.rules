rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    /* ================================================
       USER PROFILE FILES
       Path:
       users/{userId}/...
       ================================================ */

    match /users/{userId}/{allPaths=**} {

      /*
       * শুধু লগইন করা user নিজের ফাইল
       * read / upload / update / delete করতে পারবে।
       *
       * সর্বোচ্চ file size: 10 MB
       * অনুমোদিত:
       * - image/*
       * - application/pdf
       */

      allow read: if
        request.auth != null &&
        request.auth.uid == userId;

      allow write: if
        request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size <= 10 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
    }


    /* ================================================
       POSTS
       Path:
       posts/{userId}/...
       ================================================ */

    match /posts/{userId}/{allPaths=**} {

      /*
       * শুধু login করা user নিজের post media
       * upload/read/update/delete করতে পারবে।
       *
       * সর্বোচ্চ file size: 20 MB
       * অনুমোদিত:
       * - image/*
       * - video/*
       */

      allow read: if
        request.auth != null &&
        request.auth.uid == userId;

      allow write: if
        request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size <= 20 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*')
        );
    }


    /* ================================================
       EVERYTHING ELSE
       ================================================ */

    /*
     * অন্য কোনো Storage path
     * ডিফল্টভাবে সম্পূর্ণ বন্ধ।
     */

    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}