rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    // ==========================================
    // USER FILES
    // Profile photo + payment proof
    // ==========================================
    match /users/{userId}/{allPaths=**} {

      // নিজের ফাইল নিজে দেখতে পারবে
      allow read:
        if request.auth != null
        && request.auth.uid == userId;

      // শুধু image upload
      // Maximum size: 5 MB
      allow create, update:
        if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // নিজের ফাইল delete করতে পারবে
      allow delete:
        if request.auth != null
        && request.auth.uid == userId;
    }


    // ==========================================
    // POST MEDIA
    // Images + Videos
    // ==========================================
    match /posts/{userId}/{allPaths=**} {

      // নিজের পোস্টের media দেখতে পারবে
      allow read:
        if request.auth != null
        && request.auth.uid == userId;

      // Image / Video upload
      // Maximum size: 20 MB
      allow create, update:
        if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 20 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          ||
          request.resource.contentType.matches('video/.*')
        );

      // নিজের media delete
      allow delete:
        if request.auth != null
        && request.auth.uid == userId;
    }


    // ==========================================
    // EVERYTHING ELSE — BLOCK
    // ==========================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}