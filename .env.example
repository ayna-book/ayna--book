# ==========================================
# AYNA BOOK ★ Environment Configuration
# ==========================================

# সার্ভার পোর্ট ও পরিবেশ (Development / Production)
PORT=3000
NODE_ENV=production

# Google Gemini / AI API সেটিংস (ব্যাকএন্ড server.js এর জন্য)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Maps ও Google Sign-In / OAuth কনফিগারেশন
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# AYNA BOOK অ্যাপ ও রিয়েল-টাইম সিঙ্ক সেটিংস
APP_NAME=AYNA BOOK
APP_DEFAULT_URL=/ayna-book-complete-hub.html
SYNC_CHANNEL_NAME=ayna_book_live_bus_v1
MAX_REQUEST_BODY_SIZE=1mb

# ডিফল্ট GPS ও রাডার ফলব্যাক স্থানাঙ্ক (প্রয়োজনে পরিবর্তন করুন)
DEFAULT_LAT=23.8103
DEFAULT_LON=90.4125
DEFAULT_LOCATION_LABEL=Dhaka, Bangladesh