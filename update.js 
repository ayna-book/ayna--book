"use strict";

const VERSION_URL = "./version.json";
const STORAGE_KEY = "ayna_book_installed_version";

let updateCheckTimer = null;
let isUpdating = false;


// ---------------------------------------------------------
// Read Current Version
// ---------------------------------------------------------

async function getLatestVersion() {
  try {
    const response = await fetch(
      `${VERSION_URL}?t=${Date.now()}`,
      {
        method: "GET",
        cache: "no-store"
      }
    );

    if (!response.ok) {
      throw new Error(
        `Version file পাওয়া যায়নি। HTTP ${response.status}`
      );
    }

    const data = await response.json();

    const version = String(
      data?.version || ""
    ).trim();

    if (!version) {
      throw new Error(
        "version.json-এ version পাওয়া যায়নি।"
      );
    }

    return version;

  } catch (error) {
    console.error(
      "AYNA BOOK Version Check Error:",
      error
    );

    return null;
  }
}


// ---------------------------------------------------------
// Installed Version
// ---------------------------------------------------------

function getInstalledVersion() {
  return (
    localStorage.getItem(
      STORAGE_KEY
    ) || ""
  ).trim();
}


function saveInstalledVersion(version) {
  if (!version) {
    return;
  }

  localStorage.setItem(
    STORAGE_KEY,
    version
  );
}


// ---------------------------------------------------------
// Compare Versions
// ---------------------------------------------------------

function compareVersions(a, b) {
  const first =
    String(a || "")
      .split(".")
      .map(Number);

  const second =
    String(b || "")
      .split(".")
      .map(Number);

  const length =
    Math.max(
      first.length,
      second.length
    );

  for (let i = 0; i < length; i++) {
    const x =
      Number.isFinite(first[i])
        ? first[i]
        : 0;

    const y =
      Number.isFinite(second[i])
        ? second[i]
        : 0;

    if (x > y) {
      return 1;
    }

    if (x < y) {
      return -1;
    }
  }

  return 0;
}


// ---------------------------------------------------------
// Update Banner
// ---------------------------------------------------------

