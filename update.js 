    );

  if (updateButton) {
    updateButton.onclick =
      () => activateUpdate();
  }
}


// ---------------------------------------------------------
// Service Worker Registration
// ---------------------------------------------------------

async function registerServiceWorker() {

  if (
    !("serviceWorker" in navigator)
  ) {
    console.warn(
      "AYNA BOOK: Service Worker supported নয়।"
    );

    return null;
  }

  try {

    const registration =
      await navigator.serviceWorker.register(
        "./sw.js",
        {
          scope: "./"
        }
      );

    console.log(
      "AYNA BOOK Service Worker Registered:",
      registration.scope
    );

    return registration;

  } catch (error) {

    console.error(
      "AYNA BOOK Service Worker Registration Error:",
      error
    );

    return null;
  }
}


// ---------------------------------------------------------
// Activate Waiting Service Worker
// ---------------------------------------------------------

function activateWaitingWorker(
  registration
) {

  if (
    !registration ||
    !registration.waiting
  ) {
    return false;
  }

  isUpdating = true;

  registration.waiting.postMessage({
    type: "SKIP_WAITING"
  });

  return true;
}


// ---------------------------------------------------------
// Activate Update
// ---------------------------------------------------------

async function activateUpdate() {

  if (isUpdating) {
    return;
  }

  try {

    isUpdating = true;

    const registration =
      await navigator.serviceWorker.getRegistration(
        "./"
      );

    if (
      registration &&
      registration.waiting
    ) {

      registration.waiting.postMessage({
        type: "SKIP_WAITING"
      });

      return;
    }

    if (registration) {
      await registration.update();
    }

    window.location.reload(
      true
    );

  } catch (error) {

    console.error(
      "AYNA BOOK Update Activation Error:",
      error
    );

    isUpdating = false;

    alert(
      "AYNA BOOK update করা যায়নি। আবার চেষ্টা করুন।"
    );
  }
}


// ---------------------------------------------------------
// Check For Update
// ---------------------------------------------------------

async function checkForUpdate() {

  const latestVersion =
    await getLatestVersion();

  if (!latestVersion) {
    return false;
  }

  const installedVersion =
    getInstalledVersion();

  // প্রথমবার version সংরক্ষণ
  if (!installedVersion) {

    saveInstalledVersion(
      latestVersion
    );

    console.log(
      "AYNA BOOK Initial Version:",
      latestVersion
    );

    return false;
  }

  const comparison =
    compareVersions(
      latestVersion,
      installedVersion
    );

  if (comparison > 0) {

    console.log(
      "AYNA BOOK New Version Available:",
      latestVersion
    );

    showUpdateBanner(
      latestVersion
    );

    return true;
  }

  console.log(
    "AYNA BOOK: Already up to date.",
    latestVersion
  );

  return false;
}


// ---------------------------------------------------------
// Service Worker Update Handling
// ---------------------------------------------------------

async function setupServiceWorkerUpdates() {

  const registration =
    await registerServiceWorker();

  if (!registration) {
    return;
  }

  if (
    registration.waiting
  ) {
    console.log(
      "AYNA BOOK: Waiting Service Worker found."
    );

    activateWaitingWorker(
      registration
    );

    return;
  }

  registration.addEventListener(
    "updatefound",
    () => {

      const newWorker =
        registration.installing;

      if (!newWorker) {
        return;
      }

      newWorker.addEventListener(
        "statechange",
        () => {

          if (
            newWorker.state ===
            "installed" &&
            navigator.serviceWorker.controller
          ) {

            console.log(
              "AYNA BOOK: New Service Worker installed."
            );

            showUpdateBanner(
              "নতুন"
            );
          }
        }
      );
    }
  );

  navigator.serviceWorker.addEventListener(
    "controllerchange",
    () => {

      if (!isUpdating) {
        return;
      }

      window.location.reload();
    }
  );
}


// ---------------------------------------------------------
// Start Update Manager
// ---------------------------------------------------------

async function startUpdateManager() {

  try {

    await setupServiceWorkerUpdates();

    await checkForUpdate();

    // প্রতি ৫ মিনিটে update check
    updateCheckTimer =
      setInterval(
        () => {
          checkForUpdate();
        },
        5 * 60 * 1000
      );

    console.log(
      "AYNA BOOK Update Manager Started."
    );

  } catch (error) {

    console.error(
      "AYNA BOOK Update Manager Error:",
      error
    );
  }
}


// ---------------------------------------------------------
// Visibility Change
// ---------------------------------------------------------

document.addEventListener(
  "visibilitychange",
  () => {

    if (
      document.visibilityState ===
      "visible"
    ) {
      checkForUpdate();
    }
  }
);


// ---------------------------------------------------------
// Start After DOM Ready
// ---------------------------------------------------------

if (
  document.readyState ===
  "loading"
) {

  document.addEventListener(
    "DOMContentLoaded",
    startUpdateManager
  );

} else {

  startUpdateManager();
}


// ---------------------------------------------------------
// Public API
// ---------------------------------------------------------

window.AYNA_UPDATE = {
  check: checkForUpdate,
  update: activateUpdate,
  getInstalledVersion,
  saveInstalledVersion
};


console.log(
  "AYNA BOOK — update.js loaded successfully."
);