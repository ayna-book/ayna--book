      "ayna-update-banner"
    );

  if (!banner) {

    banner =
      document.createElement(
        "div"
      );

    banner.id =
      "ayna-update-banner";

    banner.style.cssText = `
      position: fixed;
      left: 16px;
      right: 16px;
      bottom: 16px;
      z-index: 99999;
      background: #1A2233;
      border: 1px solid #FFD700;
      border-radius: 14px;
      padding: 14px 16px;
