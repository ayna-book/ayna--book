<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0A0F1E">

  <title>AYNA BOOK — Forgot Password</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, Helvetica, sans-serif;
      background: #0A0F1E;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 430px;
    }

    .brand {
      text-align: center;
      margin-bottom: 24px;
    }

    .brand h1 {
      margin: 0;
      color: #FFD700;
      font-size: 36px;
      font-weight: 900;
      letter-spacing: 2px;
    }

    .brand p {
      margin: 8px 0 0;
      color: #A9B0BC;
      font-size: 14px;
    }

    .star {
      display: inline-block;
      margin-left: 7px;
      color: #ffffff;
      font-size: 16px;
      animation: glow 60s infinite;
      text-shadow: 0 0 5px #ffffff;
    }

    @keyframes glow {
      0%, 96%, 100% {
        opacity: 0.75;
        text-shadow: 0 0 5px #ffffff;
        transform: scale(1);
      }

      97% {
        opacity: 1;
        text-shadow:
          0 0 8px #ffffff,
          0 0 16px #ffffff,
          0 0 25px #FFD700;
        transform: scale(1.25);
      }

      98% {
        opacity: 1;
        text-shadow:
          0 0 10px #ffffff,
          0 0 20px #ffffff,
          0 0 30px #FFD700;
        transform: scale(1.35);
      }

      99% {
        opacity: 0.85;
        text-shadow: 0 0 8px #ffffff;
        transform: scale(1.1);
      }
    }

    .card {
      background: #1A2233;
      border: 1px solid #4A4A2A;
      border-radius: 18px;
      padding: 28px 22px;
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
    }

    .card h2 {
      margin: 0 0 10px;
      text-align: center;
      color: #FFD700;
      font-size: 24px;
    }

    .description {
      margin: 0 auto 22px;
      max-width: 340px;
      text-align: center;
      color: #A9B0BC;
      line-height: 1.6;
      font-size: 14px;
    }

    label {
      display: block;
      margin-bottom: 8px;
      color: #ffffff;
      font-size: 14px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 14px 15px;
      border: 1px solid #4A4A2A;
      border-radius: 10px;
      outline: none;
      background: #0A0F1E;
      color: #ffffff;
      font-size: 15px;
    }

    input:focus {
      border-color: #FFD700;
      box-shadow: 0 0 0 2px rgba(255, 215, 0, 0.12);
    }

    input::placeholder {
      color: #737B89;
    }

    .button {
      width: 100%;
      margin-top: 18px;
      padding: 14px;
      border: 1px solid #4A4A2A;
      border-radius: 10px;
      background: #FFD700;
      color: #0A0F1E;
      font-size: 16px;
      font-weight: 900;
      cursor: pointer;
      transition: 0.2s ease;
    }

    .button:hover {
      transform: translateY(-1px);
      box-shadow: 0 7px 20px rgba(255, 215, 0, 0.18);
    }

    .button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .message {
      display: none;
      margin-top: 16px;
      padding: 12px;
      border-radius: 9px;
      text-align: center;
      font-size: 14px;
      line-height: 1.5;
    }

    .message.success {
      display: block;
      background: rgba(46, 204, 113, 0.12);
      border: 1px solid #2ECC71;
      color: #2ECC71;
    }

    .message.error {
      display: block;
      background: rgba(255, 70, 70, 0.10);
      border: 1px solid #ff5c5c;
      color: #ff8585;
    }

    .back {
      display: block;
      margin-top: 20px;
      text-align: center;
      color: #FFD700;
      text-decoration: none;
      font-size: 14px;
      font-weight: 700;
    }

    .back:hover {
      text-decoration: underline;
    }

    .security {
      margin-top: 18px;
      padding: 12px;
      border-radius: 9px;
      background: rgba(46, 204, 113, 0.07);
      border: 1px solid rgba(46, 204, 113, 0.35);
      color: #A9B0BC;
      text-align: center;
      font-size: 12px;
      line-height: 1.5;
    }

    .security strong {
      color: #2ECC71;
    }
  </style>
</head>

<body>

  <main class="container">

    <div class="brand">
      <h1>
        AYNA BOOK
        <span class="star">★</span>
      </h1>
      <p>MY WORLD. MY STORY. MY AYNA BOOK.</p>
    </div>

    <section class="card">

      <h2>Forgot Password</h2>

      <p class="description">
        আপনার AYNA BOOK অ্যাকাউন্টের ইমেইল ঠিকানা দিন।
        আমরা আপনার পাসওয়ার্ড পরিবর্তনের জন্য একটি নিরাপদ লিংক পাঠাব।
      </p>

      <form id="forgotForm">

        <label for="email">Email Address</label>

        <input
          type="email"
          id="email"
          name="email"
          placeholder="আপনার ইমেইল লিখুন"
          autocomplete="email"
          required
        >

        <button
          type="submit"
          class="button"
          id="resetButton"
        >
          Send Reset Link
        </button>

      </form>

      <div id="message" class="message"></div>

      <div class="security">
        <strong>🔐 Secure</strong><br>
        আপনার পাসওয়ার্ড সরাসরি আমাদের কাছে প্রকাশ করা হয় না।
        Firebase Authentication-এর মাধ্যমে নিরাপদভাবে রিসেট করা হয়।
      </div>

      <a href="./login.html" class="back">
        ← Back to Login
      </a>

    </section>

  </main>

  <script type="module">

    import { resetPassword } from "./auth.js";

    const form = document.getElementById("forgotForm");
    const emailInput = document.getElementById("email");
    const resetButton = document.getElementById("resetButton");
    const message = document.getElementById("message");

    function showMessage(text, type) {
      message.textContent = text;
      message.className = "message " + type;
    }

    form.addEventListener("submit", async (event) => {

      event.preventDefault();

      const email = emailInput.value.trim();

      if (!email) {
        showMessage("দয়া করে আপনার ইমেইল ঠিকানা লিখুন।", "error");
        return;
      }

      resetButton.disabled = true;
      resetButton.textContent = "Sending...";

      message.className = "message";
      message.textContent = "";

      try {

        const result = await resetPassword(email);

        if (result.success) {

          showMessage(
            "পাসওয়ার্ড রিসেট লিংক আপনার ইমেইলে পাঠানো হয়েছে। ইনবক্স ও Spam/Junk ফোল্ডার পরীক্ষা করুন।",
            "success"
          );

          form.reset();

        } else {

          showMessage(
            result.message || "পাসওয়ার্ড রিসেট করা যায়নি।",
            "error"
          );

        }

      } catch (error) {

        console.error("AYNA BOOK Password Reset Error:", error);

        showMessage(
          "একটি সমস্যা হয়েছে। কিছুক্ষণ পর আবার চেষ্টা করুন।",
          "error"
        );

      } finally {

        resetButton.disabled = false;
        resetButton.textContent = "Send Reset Link";

      }

    });

  </script>

</body>
</html>