<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0A0F1E">

  <title>AYNA BOOK — Forgot Password</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: #0A0F1E;
      color: #ffffff;
      font-family: Arial, sans-serif;
    }

    .container {
      width: 100%;
      max-width: 430px;
    }

    .card {
      background: #1A2233;
      border: 1px solid #4A4A2A;
      border-radius: 24px;
      padding: 30px 24px;
      box-shadow: 0 15px 50px rgba(0, 0, 0, 0.45);
    }

    .brand {
      text-align: center;
      margin-bottom: 25px;
    }

    .brand h1 {
      margin: 0;
      color: #FFD700;
      font-size: 32px;
      font-weight: 800;
      letter-spacing: 2px;
    }

    .star {
      display: inline-block;
      margin-left: 6px;
      color: #ffffff;
      font-size: 16px;
      text-shadow:
        0 0 5px #ffffff,
        0 0 10px #ffffff;
      animation: glow 60s infinite;
    }

    @keyframes glow {
      0%, 97% {
        opacity: 0.8;
        transform: scale(1);
      }

      98% {
        opacity: 1;
        transform: scale(1.35);
        text-shadow:
          0 0 8px #ffffff,
          0 0 18px #ffffff,
          0 0 30px #ffffff;
      }

      100% {
        opacity: 0.8;
        transform: scale(1);
      }
    }

    .subtitle {
      margin-top: 8px;
      color: #A9B0BC;
      font-size: 14px;
    }

    h2 {
      margin: 0 0 10px;
      text-align: center;
      color: #FFD700;
      font-size: 23px;
    }

    .description {
      margin: 0 0 22px;
      text-align: center;
      color: #A9B0BC;
      line-height: 1.6;
      font-size: 14px;
    }

    label {
      display: block;
      margin-bottom: 8px;
      color: #ffffff;
      font-size: 14px;
      font-weight: 600;
    }

    input {
      width: 100%;
      padding: 14px 15px;
      margin-bottom: 16px;
      border: 1px solid #4A4A2A;
      border-radius: 12px;
      outline: none;
      background: #0A0F1E;
      color: #ffffff;
      font-size: 15px;
    }

    input:focus {
      border-color: #FFD700;
      box-shadow: 0 0 0 2px rgba(255, 215, 0, 0.12);
    }

    input::placeholder {
      color: #6f7888;
    }

    button {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 12px;
      background: #FFD700;
      color: #0A0F1E;
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
    }

    button:hover {
      filter: brightness(1.08);
    }

    button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    #auth-message {
      display: none;
      margin-top: 16px;
      padding: 12px;
      border-radius: 10px;
      text-align: center;
      font-size: 14px;
      line-height: 1.5;
    }

    #auth-message[data-type="success"] {
      display: block;
      color: #2ECC71;
      background: rgba(46, 204, 113, 0.10);
      border: 1px solid rgba(46, 204, 113, 0.35);
    }

    #auth-message[data-type="error"] {
      display: block;
      color: #ff7777;
      background: rgba(255, 80, 80, 0.10);
      border: 1px solid rgba(255, 80, 80, 0.35);
    }

    .back {
      display: block;
      margin-top: 20px;
      text-align: center;
      color: #FFD700;
      text-decoration: none;
      font-size: 14px;
    }

    .back:hover {
      text-decoration: underline;
    }

    .security {
      margin-top: 22px;
      padding: 12px;
      border-radius: 12px;
      background: #0A0F1E;
      color: #A9B0BC;
      text-align: center;
      font-size: 12px;
      line-height: 1.6;
    }
  </style>
</head>

<body>

  <main class="container">

    <section class="card">

      <div class="brand">
        <h1>
          AYNA BOOK
          <span class="star">★</span>
        </h1>

        <div class="subtitle">
          Secure Account Recovery
        </div>
      </div>


      <h2>পাসওয়ার্ড ভুলে গেছেন?</h2>

      <p class="description">
        আপনার AYNA BOOK অ্যাকাউন্টের ইমেইল ঠিকানা লিখুন।
        আমরা আপনার ইমেইলে পাসওয়ার্ড পরিবর্তনের একটি নিরাপদ লিংক পাঠাব।
      </p>


      <form id="reset-form">

        <label for="email">
          ইমেইল ঠিকানা
        </label>

        <input
          id="email"
          type="email"
          placeholder="আপনার ইমেইল লিখুন"
          autocomplete="email"
          required
        >

        <button
          id="reset-button"
          type="submit"
        >
          Reset Password
        </button>

      </form>


      <div id="auth-message"></div>


      <a
        class="back"
        href="./login.html"
      >
        ← Login পেজে ফিরে যান
      </a>


      <div class="security">
        🔒 আপনার পাসওয়ার্ড সরাসরি এই পেজে দেখা বা সংরক্ষণ করা হয় না।
        Firebase-এর নিরাপদ password reset system ব্যবহার করা হচ্ছে।
      </div>

    </section>

  </main>


  <script type="module">

    import {
      resetPassword
    } from "./auth.js";


    const form =
      document.getElementById("reset-form");

    const emailInput =
      document.getElementById("email");

    const button =
      document.getElementById("reset-button");

    const message =
      document.getElementById("auth-message");


    form.addEventListener(
      "submit",
      async (event) => {

        event.preventDefault();


        const email =
          emailInput.value.trim();


        if (!email) {

          message.textContent =
            "আপনার ইমেইল ঠিকানা লিখুন।";

          message.dataset.type = "error";

          return;
        }


        button.disabled = true;

        button.textContent =
          "পাঠানো হচ্ছে...";


        try {

          const result =
            await resetPassword(email);


          if (result.success) {

            message.textContent =
              result.message;

            message.dataset.type =
              "success";

            form.reset();

          } else {

            message.textContent =
              result.message;

            message.dataset.type =
              "error";
          }

        } catch (error) {

          console.error(
            "Password Reset Error:",
            error
          );

          message.textContent =
            "পাসওয়ার্ড reset করতে সমস্যা হয়েছে। আবার চেষ্টা করুন।";

          message.dataset.type =
            "error";

        } finally {

          button.disabled = false;

          button.textContent =
            "Reset Password";
        }

      }
    );

  </script>

</body>
</html>