<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0A0F1E">

  <title>AYNA BOOK — Forgot Password</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;

      background: #0A0F1E;
      color: #FFFFFF;

      font-family: Arial, sans-serif;

      display: flex;
      justify-content: center;
      align-items: center;

      padding: 20px;
    }

    /* =========================
       MAIN BOX
    ========================== */

    .forgot-box {
      width: 100%;
      max-width: 440px;

      background: #1A2233;

      border: 1px solid #4A4A2A;
      border-radius: 20px;

      padding: 30px 24px;

      box-shadow:
        0 12px 35px rgba(0, 0, 0, 0.35);
    }

    /* =========================
       HEADER
    ========================== */

    .brand {
      text-align: center;

      color: #FFFFFF;

      font-size: 30px;
      font-weight: 900;

      letter-spacing: 2px;

      margin-bottom: 8px;
    }

    .subtitle {
      text-align: center;

      color: #A9B0BC;

      font-size: 15px;

      line-height: 1.5;

      margin-bottom: 25px;
    }

    /* =========================
       LABEL
    ========================== */

    label {
      display: block;

      margin: 12px 0 7px;

      color: #FFFFFF;

      font-weight: bold;
    }

    /* =========================
       INPUT
    ========================== */

    input {
      width: 100%;

      padding: 14px;

      border: 1px solid #4A4A2A;
      border-radius: 10px;

      background: #0A0F1E;

      color: #FFFFFF;

      font-size: 16px;

      outline: none;
    }

    input::placeholder {
      color: #A9B0BC;
    }

    input:focus {
      border-color: #FFD700;

      box-shadow:
        0 0 10px rgba(255, 215, 0, 0.12);
    }

    /* =========================
       BUTTON
    ========================== */

    #resetBtn {
      width: 100%;

      border: 0;
      border-radius: 10px;

      padding: 14px;

      margin-top: 18px;

      background: #FFD700;

      color: #0A0F1E;

      font-size: 16px;
      font-weight: 900;

      cursor: pointer;
    }

    #resetBtn:hover {
      filter: brightness(1.08);
    }

    #resetBtn:disabled {
      opacity: 0.6;

      cursor: wait;
    }

    /* =========================
       LOGIN BUTTON
    ========================== */

    .login-btn {
      display: block;

      width: 100%;

      text-align: center;

      text-decoration: none;

      margin-top: 12px;

      padding: 14px;

      border: 1px solid #FFD700;
      border-radius: 10px;

      background: transparent;

      color: #FFD700;

      font-size: 16px;
      font-weight: 800;
    }

    .login-btn:hover {
      background: rgba(255, 215, 0, 0.08);
    }

    /* =========================
       MESSAGE
    ========================== */

    .message {
      min-height: 24px;

      margin-top: 15px;

      text-align: center;

      line-height: 1.5;

      font-size: 14px;
    }

    .success {
      color: #2ECC71;
    }

    .error {
      color: #FF6B6B;
    }

    /* =========================
       SECURITY NOTICE
    ========================== */

    .security {
      margin-top: 20px;

      padding: 12px;

      border-radius: 10px;

      background: #0A0F1E;

      border: 1px solid #4A4A2A;

      color: #A9B0BC;

      font-size: 13px;

      line-height: 1.6;

      text-align: center;
    }

    .security strong {
      color: #FFFFFF;
    }

    /* =========================
       MOBILE
    ========================== */

    @media (max-width: 480px) {

      body {
        padding: 14px;
      }

      .forgot-box {
        padding: 25px 18px;
        border-radius: 18px;
      }

      .brand {
        font-size: 26px;
      }

    }

  </style>
</head>

<body>

  <main class="forgot-box">

    <!-- =========================
         BRAND
    ========================== -->

    <div class="brand">
      AYNA BOOK
    </div>

    <div class="subtitle">
      আপনার অ্যাকাউন্টের পাসওয়ার্ড পুনরায় সেট করুন
    </div>


    <!-- =========================
         FORM
    ========================== -->

    <form id="forgotForm">

      <label for="email">
        ইমেইল
      </label>

      <input
        id="email"
        type="email"
        placeholder="আপনার অ্যাকাউন্টের ইমেইল লিখুন"
        autocomplete="email"
        required
      >


      <button
        id="resetBtn"
        type="submit"
      >
        পাসওয়ার্ড রিসেট করুন
      </button>

    </form>


    <!-- =========================
         LOGIN
    ========================== -->

    <a
      class="login-btn"
      href="login.html"
    >
      লগইন পেজে ফিরে যান
    </a>


    <!-- =========================
         MESSAGE
    ========================== -->

    <div
      id="message"
      class="message"
    ></div>


    <!-- =========================
         SECURITY
    ========================== -->

    <div class="security">

      <strong>🔐 নিরাপত্তা:</strong>

      <br>

      আপনার ইমেইলে একটি password reset link পাঠানো হবে।
      কারও সঙ্গে আপনার password বা reset link শেয়ার করবেন না।

    </div>

  </main>


  <!-- =========================
       FIREBASE AUTH
  ========================== -->

  <script type="module">

    import {
      resetPassword
    } from "./auth.js";


    /* =========================
       ELEMENTS
    ========================== */

    const form =
      document.getElementById(
        "forgotForm"
      );

    const emailInput =
      document.getElementById(
        "email"
      );

    const resetBtn =
      document.getElementById(
        "resetBtn"
      );

    const message =
      document.getElementById(
        "message"
      );


    /* =========================
       MESSAGE FUNCTION
    ========================== */

    function showMessage(
      text,
      type = "error"
    ) {

      message.textContent = text;

      message.className =
        "message " + type;

    }


    /* =========================
       RESET PASSWORD
    ========================== */

    form.addEventListener(
      "submit",
      async (event) => {

        event.preventDefault();


        const email =
          emailInput.value.trim();


        /* Email validation */

        if (!email) {

          showMessage(
            "আপনার ইমেইল লিখুন।",
            "error"
          );

          emailInput.focus();

          return;
        }


        /* Loading */

        resetBtn.disabled = true;

        resetBtn.textContent =
          "পাঠানো হচ্ছে...";


        showMessage(
          "আপনার ইমেইল যাচাই করা হচ্ছে...",
          "success"
        );


        try {

          const result =
            await resetPassword(
              email
            );


          if (result.success) {

            showMessage(
              result.message ||
              "Password reset link আপনার ইমেইলে পাঠানো হয়েছে।",
              "success"
            );

            form.reset();

          } else {

            showMessage(
              result.message ||
              "Password reset করা যায়নি।",
              "error"
            );

          }

        } catch (error) {

          console.error(
            "AYNA BOOK Password Reset Error:",
            error
          );

          showMessage(
            "Password reset করার সময় একটি সমস্যা হয়েছে।",
            "error"
          );

        } finally {

          resetBtn.disabled = false;

          resetBtn.textContent =
            "পাসওয়ার্ড রিসেট করুন";

        }

      }
    );

  </script>

</body>
</html>