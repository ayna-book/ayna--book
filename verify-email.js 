import {
  auth
} from "./firebase.js";

import {
  watchAuthState,
  checkEmailVerification,
  resendVerificationEmail,
  activateVerifiedAccount,
  logoutUser,
  getAuthErrorMessage
} from "./auth.js";


// =========================================================
// DOM
// =========================================================

const emailElement =
  document.getElementById("email");

const checkButton =
  document.getElementById("checkButton");

const resendButton =
  document.getElementById("resendButton");

const logoutButton =
  document.getElementById("logoutButton");

const statusElement =
  document.getElementById("status");


// =========================================================
// STATUS
// =========================================================

function setStatus(
  message
) {
  if (statusElement) {
    statusElement.textContent =
      message;
  }
}


// =========================================================
// REDIRECT
// =========================================================

function goToProfile() {
  window.location.href =
    "./profile.html";
}


// =========================================================
// AUTH STATE
// =========================================================

watchAuthState(
  async (user) => {

    if (!user) {
      setStatus(
        "আপনি Login করা নেই।"
      );

      return;
    }

    if (emailElement) {
      emailElement.textContent =
        user.email || "";
    }

    try {

      const verified =
        await checkEmailVerification();

      if (verified) {

        await activateVerifiedAccount();

        setStatus(
          "Email verification সফল হয়েছে।"
        );

        setTimeout(
          goToProfile,
          800
        );

      } else {

        setStatus(
          "আপনার Gmail এখনো verify হয়নি।"
        );
      }

    } catch (error) {

      setStatus(
        getAuthErrorMessage(
          error
        )
      );
    }
  }
);


// =========================================================
// CHECK BUTTON
// =========================================================

checkButton?.addEventListener(
  "click",
  async () => {

    checkButton.disabled = true;

    setStatus(
      "Verification status পরীক্ষা করা হচ্ছে..."
    );

    try {

      const verified =
        await checkEmailVerification();

      if (!verified) {

        setStatus(
          "এখনো verify হয়নি। Gmail থেকে verification link খুলুন।"
        );

        return;
      }

      await activateVerifiedAccount();

      setStatus(
        "Verification সফল।"
      );

      setTimeout(
        goToProfile,
        700
      );

    } catch (error) {

      setStatus(
        getAuthErrorMessage(
          error
        )
      );

    } finally {

      checkButton.disabled = false;
    }
  }
);


// =========================================================
// RESEND
// =========================================================

resendButton?.addEventListener(
  "click",
  async () => {

    resendButton.disabled = true;

    setStatus(
      "Verification email পাঠানো হচ্ছে..."
    );

    try {

      const result =
        await resendVerificationEmail();

      if (result.alreadyVerified) {

        setStatus(
          "আপনার Email ইতিমধ্যে verified।"
        );

        setTimeout(
          goToProfile,
          700
        );

        return;
      }

      setStatus(
        "Verification email আবার পাঠানো হয়েছে। Gmail Inbox/Spam দেখুন।"
      );

    } catch (error) {

      setStatus(
        getAuthErrorMessage(
          error
        )
      );

    } finally {

      resendButton.disabled = false;
    }
  }
);


// =========================================================
// LOGOUT
// =========================================================

logoutButton?.addEventListener(
  "click",
  async () => {

    try {

      await logoutUser();

      window.location.href =
        "./index.html";

    } catch (error) {

      setStatus(
        getAuthErrorMessage(
          error
        )
      );
    }
  }
);