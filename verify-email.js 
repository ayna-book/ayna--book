import {
  checkEmailVerification,
  resendVerificationEmail,
  logoutUser,
  getCurrentUser
} from "./auth.js";


// =========================================================
// ELEMENTS
// =========================================================

const emailBox =
  document.getElementById("emailBox");

const checkButton =
  document.getElementById("checkButton");

const resendButton =
  document.getElementById("resendButton");

const logoutButton =
  document.getElementById("logoutButton");

const messageBox =
  document.getElementById("message");


// =========================================================
// AYNA BOOK OFFICIAL EMAIL
// =========================================================

const expectedEmail =
  "aynabookofficeal@gmail.com";


// =========================================================
// MESSAGE
// =========================================================

function showMessage(text, type = "error") {

  if (!messageBox) return;

  messageBox.textContent = text;

  messageBox.className =
    "message show " + type;
}


// =========================================================
// GET CURRENT USER
// =========================================================

function getUser() {

  return getCurrentUser();

}


// =========================================================
// DISPLAY EMAIL
// =========================================================

function displayUserEmail() {

  const user = getUser();

  if (!user) {

    emailBox.textContent =
      expectedEmail;

    return null;
  }

  const userEmail =
    (user.email || "").trim().toLowerCase();

  emailBox.textContent =
    user.email || expectedEmail;

  return user;
}


// =========================================================
// INITIAL CHECK
// =========================================================

const currentUser =
  displayUserEmail();


if (!currentUser) {

  showMessage(
    "No signed-in account was found. Please sign in first.",
    "error"
  );

  setTimeout(function () {

    window.location.replace(
      "login.html"
    );

  }, 1500);
}


// =========================================================
// CHECK VERIFICATION
// =========================================================

if (checkButton) {

  checkButton.addEventListener(
    "click",
    async function () {

      checkButton.disabled = true;

      checkButton.textContent =
        "Checking...";

      try {

        const result =
          await checkEmailVerification();


        if (!result.success) {

          showMessage(
            result.message ||
            "Unable to check email verification.",
            "error"
          );

          return;
        }


        // -------------------------------------------------
        // VERIFIED
        // -------------------------------------------------

        if (result.verified) {

          showMessage(
            "Email verified successfully. Opening AYNA BOOK...",
            "success"
          );


          setTimeout(function () {

            window.location.replace(
              "home.html"
            );

          }, 1000);

          return;
        }


        // -------------------------------------------------
        // NOT VERIFIED
        // -------------------------------------------------

        showMessage(
          "Your email is not verified yet. Please open the verification email and click the verification link.",
          "error"
        );

      } catch (error) {

        console.error(
          "AYNA BOOK Verification Check Error:",
          error
        );

        showMessage(
          "An error occurred while checking verification.",
          "error"
        );

      } finally {

        checkButton.disabled = false;

        checkButton.textContent =
          "I've Verified My Email";

      }

    }
  );

}


// =========================================================
// RESEND VERIFICATION EMAIL
// =========================================================

if (resendButton) {

  resendButton.addEventListener(
    "click",
    async function () {

      resendButton.disabled = true;

      resendButton.textContent =
        "Sending...";


      try {

        const user =
          getUser();


        if (!user) {

          showMessage(
            "No signed-in account was found.",
            "error"
          );

          return;
        }


        const result =
          await resendVerificationEmail();


        if (result.success) {

          showMessage(
            "Verification email sent successfully. Please check your inbox and Spam/Junk folder.",
            "success"
          );

        } else {

          showMessage(
            result.message ||
            "Unable to send verification email.",
            "error"
          );

        }

      } catch (error) {

        console.error(
          "AYNA BOOK Resend Verification Error:",
          error
        );

        showMessage(
          "Unable to send the verification email. Please try again.",
          "error"
        );

      } finally {

        resendButton.disabled = false;

        resendButton.textContent =
          "Resend Verification Email";

      }

    }
  );

}


// =========================================================
// SIGN OUT
// =========================================================

if (logoutButton) {

  logoutButton.addEventListener(
    "click",
    async function () {

      logoutButton.disabled = true;

      logoutButton.textContent =
        "Signing Out...";


      try {

        const result =
          await logoutUser();


        if (result.success) {

          sessionStorage.removeItem(
            "verificationEmail"
          );

          window.location.replace(
            "login.html"
          );

          return;
        }


        showMessage(
          result.message ||
          "Unable to sign out.",
          "error"
        );

      } catch (error) {

        console.error(
          "AYNA BOOK Logout Error:",
          error
        );

        showMessage(
          "Unable to sign out. Please try again.",
          "error"
        );

      } finally {

        logoutButton.disabled = false;

        logoutButton.textContent =
          "Sign Out";

      }

    }
  );

}


// =========================================================
// AUTO-CHECK AFTER PAGE LOAD
// =========================================================

setTimeout(async function () {

  const user =
    getUser();

  if (!user) return;

  try {

    const result =
      await checkEmailVerification();


    if (result.success && result.verified) {

      showMessage(
        "Email already verified. Opening AYNA BOOK...",
        "success"
      );


      setTimeout(function () {

        window.location.replace(
          "home.html"
        );

      }, 700);

    }

  } catch (error) {

    console.error(
      "AYNA BOOK Auto Verification Error:",
      error
    );

  }

}, 1000);