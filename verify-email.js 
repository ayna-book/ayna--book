// Firebase SDK: 13.4.0
// =========================================================

import {
  auth,
  db
} from "./firebase-init.js";

import {
  reload,
  sendEmailVerification,
  signOut,
  onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/13.4.0/firebase-auth.js";

import {
  doc,
  updateDoc,
  serverTimestamp
} from "https://www.gstatic.com/firebasejs/13.4.0/firebase-firestore.js";


// =========================================================
// ELEMENTS
// =========================================================

const emailAddress =
  document.getElementById("emailAddress");

const checkButton =
  document.getElementById("checkButton");

const resendButton =
  document.getElementById("resendButton");

const loginButton =
  document.getElementById("loginButton");

const statusMessage =
  document.getElementById("statusMessage");


// =========================================================
// MESSAGE
// =========================================================

function showMessage(message) {
  statusMessage.textContent = message;
}


// =========================================================
// AUTH STATE
// =========================================================

onAuthStateChanged(auth, async (user) => {

  if (!user) {
    emailAddress.textContent = "No account is currently signed in.";

    showMessage(
      "Please create an account first, or return to Login."
    );

    checkButton.disabled = true;
    resendButton.disabled = true;

    return;
  }

  emailAddress.textContent =
    user.email || "Gmail account";

  try {
    await reload(user);

    if (user.emailVerified) {
      showMessage(
        "Your Gmail is already verified. Activating your account..."
      );

      await activateAccount();

      return;
    }

    showMessage(
      "Open Gmail, verify your email, then press the button above."
    );

  } catch (error) {

    console.error(
      "Verification page error:",
      error
    );

    showMessage(
      error?.message ||
      "Unable to load verification status."
    );
  }

});


// =========================================================
// ACTIVATE VERIFIED ACCOUNT
// =========================================================

async function activateAccount() {

  const user = auth.currentUser;

  if (!user) {
    throw new Error(
      "No authenticated account found."
    );
  }

  await reload(user);

  if (!user.emailVerified) {
    throw new Error(
      "Gmail verification is not complete yet."
    );
  }

  // Refresh Firebase token so email_verified
  // claim becomes available to Firestore Rules.
  await user.getIdToken(true);

  await updateDoc(
    doc(db, "users", user.uid),
    {
      emailVerified: true,
      accountStatus: "active",
      updatedAt: serverTimestamp()
    }
  );

  showMessage(
    "Gmail verified successfully. Your account is now active."
  );

  checkButton.disabled = true;
  resendButton.disabled = true;

  setTimeout(() => {
    window.location.href = "./profile.html";
  }, 1200);
}


// =========================================================
// CHECK VERIFICATION
// =========================================================

checkButton.addEventListener(
  "click",
  async () => {

    checkButton.disabled = true;
    showMessage(
      "Checking your Gmail verification..."
    );

    try {

      const user = auth.currentUser;

      if (!user) {
        throw new Error(
          "No authenticated account found."
        );
      }

      await reload(user);

      if (!user.emailVerified) {

        showMessage(
          "Gmail is not verified yet. Open the verification email and click its link."
        );

        checkButton.disabled = false;
        return;
      }

      await activateAccount();

    } catch (error) {

      console.error(
        "Verification check failed:",
        error
      );

      showMessage(
        error?.message ||
        "Verification could not be completed."
      );

      checkButton.disabled = false;
    }

  }
);


// =========================================================
// RESEND VERIFICATION
// =========================================================

resendButton.addEventListener(
  "click",
  async () => {

    resendButton.disabled = true;

    showMessage(
      "Sending verification email..."
    );

    try {

      const user = auth.currentUser;

      if (!user) {
        throw new Error(
          "No authenticated account found."
        );
      }

      await reload(user);

      if (user.emailVerified) {
        await activateAccount();
        return;
      }

      await sendEmailVerification(user);

      showMessage(
        "Verification email sent. Please check your Gmail inbox and Spam folder."
      );

    } catch (error) {

      console.error(
        "Resend verification failed:",
        error
      );

      showMessage(
        error?.message ||
        "Could not resend the verification email."
      );

    } finally {

      resendButton.disabled = false;
    }

  }
);


// =========================================================
// GO TO LOGIN
// =========================================================

loginButton.addEventListener(
  "click",
  async () => {

    try {
      await signOut(auth);
    } catch (error) {
      console.error(
        "Logout before login failed:",
        error
      );
    }

    window.location.href = "./login.html";
  }
);