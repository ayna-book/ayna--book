import {
  auth,
  sendVerificationEmail,
  logoutUser,
  getAuthErrorMessage,
  watchAuthState
} from "./auth.js";

import {
  reload
} from "https://www.gstatic.com/firebasejs/13.4.0/firebase-auth.js";


// =========================================================
// HTML ELEMENTS
// =========================================================

const userEmailElement =
  document.getElementById("userEmail");

const checkButton =
  document.getElementById("checkButton");

const resendButton =
  document.getElementById("resendButton");

const logoutButton =
  document.getElementById("logoutButton");

const statusMessage =
  document.getElementById("statusMessage");


// =========================================================
// STATE
// =========================================================

let isProcessing = false;
let resendCooldown = false;
let isRedirecting = false;
let isInitialized = false;


// =========================================================
// STATUS MESSAGE
// =========================================================

function showStatus(message, type = "info") {

  if (!statusMessage) return;

  statusMessage.textContent = message;

  statusMessage.className =
    "status-message " + type;
}


// =========================================================
// BUTTON LOADING
// =========================================================

function setButtonLoading(button, loading, text) {

  if (!button) return;

  if (loading) {

    if (!button.dataset.originalText) {
      button.dataset.originalText =
        button.textContent;
    }

    button.disabled = true;
    button.textContent = text;

  } else {

    button.textContent =
      button.dataset.originalText ||
      button.textContent;

    button.disabled = false;
  }
}


// =========================================================
// REDIRECT TO LOGIN
// =========================================================

function redirectToLogin(message, type = "warning") {

  if (isRedirecting) return;

  isRedirecting = true;

  showStatus(message, type);

  setTimeout(() => {

    window.location.replace("./login.html");

  }, 2000);
}


// =========================================================
// GET CURRENT USER
// =========================================================

function getCurrentAccount() {

  const user = auth.currentUser;

  if (!user) {

    redirectToLogin(
      "আপনার Login Session পাওয়া যায়নি। Login পেজে নেওয়া হচ্ছে...",
      "warning"
    );

    return null;
  }

  return user;
}


// =========================================================
// DISPLAY EMAIL
// =========================================================

function displayUserEmail(user) {

  if (!userEmailElement) return;

  userEmailElement.textContent =
    user.email || "Gmail পাওয়া যায়নি।";
}


// =========================================================
// CHECK EMAIL VERIFICATION
// =========================================================

async function checkEmailVerification() {

  if (isProcessing || isRedirecting) return;

  const user = getCurrentAccount();

  if (!user) return;

  isProcessing = true;

  setButtonLoading(
    checkButton,
    true,
    "Checking..."
  );

  try {

    await reload(user);

    const updatedUser = auth.currentUser;

    if (!updatedUser) {

      throw new Error("AUTH_USER_NOT_FOUND");
    }

    displayUserEmail(updatedUser);

    if (updatedUser.emailVerified === true) {

      redirectToLogin(
        "আপনার Gmail সফলভাবে Verify হয়েছে। Login পেজে নেওয়া হচ্ছে...",
        "success"
      );

    } else {

      showStatus(
        "আপনার Gmail এখনো Verify হয়নি। Gmail Inbox থেকে Verification Link খুলুন।",
        "warning"
      );
    }

  } catch (error) {

    console.error(
      "AYNA BOOK Verification Check Error:",
      error
    );

    showStatus(
      getAuthErrorMessage(error),
      "error"
    );

  } finally {

    isProcessing = false;

    setButtonLoading(
      checkButton,
      false
    );
  }
}


// =========================================================
// RESEND VERIFICATION EMAIL
// =========================================================

async function resendVerificationEmailHandler() {

  if (isProcessing || resendCooldown || isRedirecting) {
    return;
  }

  const user = getCurrentAccount();

  if (!user) return;

  isProcessing = true;

  setButtonLoading(
    resendButton,
    true,
    "Sending..."
  );

  try {

    await reload(user);

    const updatedUser = auth.currentUser;

    if (!updatedUser) {

      throw new Error("AUTH_USER_NOT_FOUND");
    }

    if (updatedUser.emailVerified === true) {

      redirectToLogin(
        "আপনার Gmail ইতিমধ্যে Verify করা হয়েছে। Login পেজে নেওয়া হচ্ছে...",
        "success"
      );

      return;
    }

    await sendVerificationEmail(updatedUser);

    showStatus(
      "নতুন Verification Email পাঠানো হয়েছে। Gmail Inbox এবং Spam/Junk folder পরীক্ষা করুন।",
      "success"
    );

    // 60-second cooldown
    resendCooldown = true;

    if (resendButton) {
      resendButton.disabled = true;
    }

    setTimeout(() => {

      resendCooldown = false;

      if (
        resendButton &&
        !isProcessing &&
        auth.currentUser &&
        !isRedirecting
      ) {
        resendButton.disabled = false;
      }

    }, 60000);

  } catch (error) {

    console.error(
      "AYNA BOOK Resend Verification Error:",
      error
    );

    let message = getAuthErrorMessage(error);

    if (error?.code === "auth/too-many-requests") {

      message =
        "অনেকবার Verification Email চাওয়া হয়েছে। কিছুক্ষণ অপেক্ষা করে আবার চেষ্টা করুন।";

    } else if (
      error?.code === "auth/network-request-failed"
    ) {

      message =
        "Internet Connection পরীক্ষা করে আবার চেষ্টা করুন।";
    }

    showStatus(message, "error");

  } finally {

    isProcessing = false;

    setButtonLoading(
      resendButton,
      false
    );

    if (resendCooldown && resendButton) {
      resendButton.disabled = true;
    }
  }
}


// =========================================================
// LOGOUT
// =========================================================

async function handleLogout() {

  if (isProcessing || isRedirecting) return;

  isProcessing = true;

  setButtonLoading(
    logoutButton,
    true,
    "Logging out..."
  );

  try {

    await logoutUser();

    window.location.replace("./login.html");

  } catch (error) {

    console.error(
      "AYNA BOOK Logout Error:",
      error
    );

    showStatus(
      getAuthErrorMessage(error),
      "error"
    );

    isProcessing = false;

    setButtonLoading(
      logoutButton,
      false
    );
  }
}


// =========================================================
// BUTTON EVENTS
// =========================================================

if (checkButton) {

  checkButton.addEventListener(
    "click",
    checkEmailVerification
  );
}

if (resendButton) {

  resendButton.addEventListener(
    "click",
    resendVerificationEmailHandler
  );
}

if (logoutButton) {

  logoutButton.addEventListener(
    "click",
    handleLogout
  );
}


// =========================================================
// INITIALIZE VERIFICATION PAGE
// =========================================================

function initializeVerificationPage(user) {

  if (isInitialized || isRedirecting) return;

  isInitialized = true;

  displayUserEmail(user);

  if (user.emailVerified === true) {

    redirectToLogin(
      "আপনার Gmail ইতিমধ্যে Verify করা হয়েছে। Login পেজে নেওয়া হচ্ছে...",
      "success"
    );

  } else {

    showStatus(
      "আপনার Gmail Verify করার জন্য Inbox পরীক্ষা করুন।",
      "info"
    );
  }
}


// =========================================================
// WAIT FOR FIREBASE AUTH SESSION
// =========================================================

watchAuthState((user) => {

  if (isRedirecting) return;

  if (!user) {

    redirectToLogin(
      "আপনার Login Session পাওয়া যায়নি। Login পেজে নেওয়া হচ্ছে...",
      "warning"
    );

    return;
  }

  initializeVerificationPage(user);
});


// =========================================================
// START
// =========================================================

console.log(
  "AYNA BOOK - verify-email.js loaded successfully."
);
