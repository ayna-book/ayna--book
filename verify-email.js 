import {
  onAuthStateChanged,
  reload,
  sendEmailVerification,
  signOut
} from "https://www.gstatic.com/firebasejs/13.4.0/firebase-auth.js";

import {
  auth,
  authReady
} from "./firebase-init.js";

import {
  ref,
  update
} from "https://www.gstatic.com/firebasejs/13.4.0/firebase-database.js";

import {
  database
} from "./firebase-init.js";


// ============================================================
// ELEMENTS
// ============================================================

const emailBox = document.getElementById("emailBox");
const messageBox = document.getElementById("message");

const checkButton = document.getElementById("checkButton");
const resendButton = document.getElementById("resendButton");
const logoutButton = document.getElementById("logoutButton");


// ============================================================
// STATE
// ============================================================

let currentUser = null;
let resendBusy = false;
let checkBusy = false;


// ============================================================
// HELPERS
// ============================================================

function showMessage(text, type = "info") {
  if (!messageBox) return;

  messageBox.textContent = text;

  if (type === "success") {
    messageBox.style.color = "#00ff99";
  } else if (type === "error") {
    messageBox.style.color = "#ff6b6b";
  } else if (type === "warning") {
    messageBox.style.color = "#ffd700";
  } else {
    messageBox.style.color = "#ffffff";
  }
}


function setButtonLoading(button, loadingText, normalText, disabled) {
  if (!button) return;

  button.disabled = disabled;

  if (disabled) {
    button.dataset.originalText = button.textContent;
    button.textContent = loadingText;
  } else {
    button.textContent =
      button.dataset.originalText || normalText;
  }
}


function showEmail(email) {
  if (!emailBox) return;

  emailBox.textContent = email || "ইমেইল পাওয়া যায়নি";
}


// ============================================================
// AUTH READY
// ============================================================

async function waitForAuth() {
  try {
    await authReady;
  } catch (error) {
    console.warn("Auth persistence warning:", error);
  }
}


// ============================================================
// SAVE VERIFICATION STATUS
// ============================================================

async function saveVerificationStatus(user) {
  if (!user) return;

  try {
    const userRef = ref(database, `users/${user.uid}`);

    await update(userRef, {
      emailVerified: true,
      emailVerifiedAt: Date.now()
    });

  } catch (error) {
    /*
      Firebase Auth-এর emailVerified-ই আসল verification status।
      RTDB update ব্যর্থ হলেও verified login আটকানো হবে না।
    */

    console.warn(
      "RTDB verification status update failed:",
      error
    );
  }
}


// ============================================================
// CHECK EMAIL VERIFICATION
// ============================================================

async function checkEmailVerification() {

  if (checkBusy) return;

  checkBusy = true;

  setButtonLoading(
    checkButton,
    "⏳ যাচাই করা হচ্ছে...",
    "✅ আমি ইমেইল যাচাই করেছি",
    true
  );

  showMessage(
    "আপনার ইমেইল যাচাই হয়েছে কি না পরীক্ষা করা হচ্ছে..."
  );

  try {

    const user = auth.currentUser;

    if (!user) {
      showMessage(
        "লগইন সেশন পাওয়া যায়নি। আবার লগইন করুন।",
        "error"
      );

      setTimeout(() => {
        window.location.href = "./login.html";
      }, 1200);

      return;
    }

    currentUser = user;

    // Firebase থেকে সর্বশেষ user status আনা
    await reload(user);

    const updatedUser = auth.currentUser;

    if (!updatedUser) {
      throw new Error("USER_SESSION_LOST");
    }

    if (updatedUser.emailVerified === true) {

      await saveVerificationStatus(updatedUser);

      showMessage(
        "✅ আপনার ইমেইল সফলভাবে যাচাই হয়েছে। Profile খুলছে...",
        "success"
      );

      setTimeout(() => {
        window.location.href = "./profile.html";
      }, 900);

      return;
    }

    showMessage(
      "❌ এখনো ইমেইল যাচাই হয়নি। Gmail-এর Verification Link খুলে আবার এই বাটনে চাপুন।",
      "warning"
    );

  } catch (error) {

    console.error(
      "AYNA BOOK verification check error:",
      error
    );

    if (error.code === "auth/network-request-failed") {

      showMessage(
        "ইন্টারনেট সংযোগ পরীক্ষা করুন এবং আবার চেষ্টা করুন।",
        "error"
      );

    } else if (error.code === "auth/requires-recent-login") {

      showMessage(
        "নিরাপত্তার জন্য আবার লগইন করতে হবে।",
        "error"
      );

    } else {

      showMessage(
        "Verification status পরীক্ষা করা যায়নি। আবার চেষ্টা করুন।",
        "error"
      );
    }

  } finally {

    checkBusy = false;

    setButtonLoading(
      checkButton,
      "⏳ যাচাই করা হচ্ছে...",
      "✅ আমি ইমেইল যাচাই করেছি",
      false
    );
  }
}


// ============================================================
// RESEND VERIFICATION EMAIL
// ============================================================

async function resendVerificationEmail() {

  if (resendBusy) return;

  resendBusy = true;

  setButtonLoading(
    resendButton,
    "⏳ পাঠানো হচ্ছে...",
    "📩 Verification Email আবার পাঠান",
    true
  );

  showMessage(
    "📩 Verification Email পাঠানো হচ্ছে..."
  );

  try {

    const user = auth.currentUser;

    if (!user) {

      showMessage(
        "লগইন সেশন পাওয়া যায়নি। আবার লগইন করুন।",
        "error"
      );

      setTimeout(() => {
        window.location.href = "./login.html";
      }, 1200);

      return;
    }

    currentUser = user;

    // প্রথমে latest status reload
    await reload(user);

    if (auth.currentUser.emailVerified === true) {

      showMessage(
        "✅ আপনার ইমেইল ইতিমধ্যেই যাচাই করা হয়েছে।",
        "success"
      );

      await saveVerificationStatus(auth.currentUser);

      setTimeout(() => {
        window.location.href = "./profile.html";
      }, 900);

      return;
    }

    await sendEmailVerification(auth.currentUser);

    showMessage(
      "✅ Verification Email পাঠানো হয়েছে। Gmail-এর Inbox অথবা Spam/Junk folder দেখুন।",
      "success"
    );

  } catch (error) {

    console.error(
      "AYNA BOOK resend verification error:",
      error
    );

    switch (error.code) {

      case "auth/too-many-requests":
        showMessage(
          "⚠️ খুব দ্রুত অনেকবার চেষ্টা হয়েছে। কিছুক্ষণ পরে আবার চেষ্টা করুন।",
          "warning"
        );
        break;

      case "auth/network-request-failed":
        showMessage(
          "🌐 ইন্টারনেট সংযোগ পরীক্ষা করুন।",
          "error"
        );
        break;

      case "auth/email-already-in-use":
        showMessage(
          "এই ইমেইল ইতিমধ্যে ব্যবহৃত হয়েছে।",
          "error"
        );
        break;

      default:
        showMessage(
          "Verification Email পাঠানো যায়নি। কিছুক্ষণ পরে আবার চেষ্টা করুন।",
          "error"
        );
        break;
    }

  } finally {

    resendBusy = false;

    setButtonLoading(
      resendButton,
      "⏳ পাঠানো হচ্ছে...",
      "📩 Verification Email আবার পাঠান",
      false
    );
  }
}


// ============================================================
// SIGN OUT
// ============================================================

async function logoutUser() {

  if (logoutButton) {
    logoutButton.disabled = true;
    logoutButton.textContent = "⏳ Sign Out...";
  }

  try {

    await signOut(auth);

    window.location.href = "./login.html";

  } catch (error) {

    console.error(
      "AYNA BOOK sign out error:",
      error
    );

    showMessage(
      "Sign Out করা যায়নি। আবার চেষ্টা করুন।",
      "error"
    );

    if (logoutButton) {
      logoutButton.disabled = false;
      logoutButton.textContent = "Sign Out";
    }
  }
}


// ============================================================
// AUTH STATE
// ============================================================

async function initializeVerificationPage() {

  await waitForAuth();

  onAuthStateChanged(auth, async (user) => {

    if (!user) {

      showEmail("");

      showMessage(
        "আপনি লগইন করা নেই। Login page-এ নেওয়া হচ্ছে...",
        "warning"
      );

      setTimeout(() => {
        window.location.href = "./login.html";
      }, 1000);

      return;
    }

    currentUser = user;

    showEmail(user.email);

    try {

      await reload(user);

      const latestUser = auth.currentUser;

      if (!latestUser) {
        throw new Error("USER_SESSION_LOST");
      }

      currentUser = latestUser;

      showEmail(latestUser.email);

      // যদি ইতিমধ্যে verified থাকে
      if (latestUser.emailVerified === true) {

        await saveVerificationStatus(latestUser);

        showMessage(
          "✅ আপনার ইমেইল ইতিমধ্যেই যাচাই করা হয়েছে। Profile খুলছে...",
          "success"
        );

        setTimeout(() => {
          window.location.href = "./profile.html";
        }, 800);

        return;
      }

      showMessage(
        "আপনার Gmail-এ পাঠানো Verification Link খুলুন। তারপর নিচের বাটনে চাপুন।",
        "info"
      );

    } catch (error) {

      console.error(
        "AYNA BOOK initial verification error:",
        error
      );

      showMessage(
        "ইমেইল যাচাইয়ের অবস্থা পড়া যায়নি। নিচের বাটন দিয়ে আবার চেষ্টা করুন।",
        "warning"
      );
    }

  });
}


// ============================================================
// BUTTON EVENTS
// ============================================================

if (checkButton) {
  checkButton.addEventListener(
    "click",
    checkEmailVerification
  );
}


if (resendButton) {
  resendButton.addEventListener(
    "click",
    resendVerificationEmail
  );
}


if (logoutButton) {
  logoutButton.addEventListener(
    "click",
    logoutUser
  );
}


// ============================================================
// START
// ============================================================

initializeVerificationPage();