
// =========================================================
// AYNA BOOK — EMAIL VERIFICATION
// Firebase Authentication + Realtime Database
// Firebase SDK 13.4.0
// =========================================================

import {
  onAuthStateChanged,
  reload,
  sendEmailVerification,
  signOut
} from "https://www.gstatic.com/firebasejs/13.4.0/firebase-auth.js";

import {
  ref,
  update
} from "https://www.gstatic.com/firebasejs/13.4.0/firebase-database.js";

import { auth, database } from "./firebase-init.js";

const $ = id => document.getElementById(id);

let currentUser = null;
let checking = false;
let sending = false;

function showMessage(message, type = "info") {
  const box = $("message");
  if (!box) return;

  box.textContent = message;
  box.className = `message show ${type}`;
}

function displayEmail(user) {
  const emailBox = $("emailBox");

  if (emailBox) {
    emailBox.textContent =
      user?.email ||
      "আপনার ইমেইল দিয়ে Login করুন";
  }
}

function updateButtons() {
  if ($("checkButton")) {
    $("checkButton").disabled = !currentUser || checking;
  }

  if ($("resendButton")) {
    $("resendButton").disabled = !currentUser || sending;
  }

  if ($("logoutButton")) {
    $("logoutButton").disabled = !currentUser;
  }
}


// =========================================================
// AUTH STATE
// =========================================================

onAuthStateChanged(auth, user => {
  currentUser = user || null;

  displayEmail(user);
  updateButtons();

  if (!user) {
    showMessage(
      "এই পেজে যাচাই করতে আগে আপনার নিবন্ধিত অ্যাকাউন্ট দিয়ে Login করুন।",
      "info"
    );
  } else if (user.emailVerified) {
    showMessage(
      "আপনার ইমেইল ইতিমধ্যে যাচাই করা হয়েছে।",
      "success"
    );
  } else {
    showMessage(
      "আপনার ইমেইল এখনো যাচাই হয়নি। Gmail খুলে Verification Link-এ চাপ দিন।",
      "info"
    );
  }
});


// =========================================================
// CHECK EMAIL VERIFICATION
// =========================================================

$("checkButton")?.addEventListener("click", async () => {
  if (!currentUser || checking) {
    showMessage("আগে আপনার অ্যাকাউন্ট দিয়ে Login করুন।", "error");
    return;
  }

  checking = true;
  updateButtons();

  try {
    await reload(currentUser);

    if (!currentUser.emailVerified) {
      showMessage(
        "এখনো Email Verification পাওয়া যায়নি। Gmail-এর Verification Link খুলে আবার চেষ্টা করুন।",
        "error"
      );
      return;
    }

    // Update local Firebase user state
    const uid = currentUser.uid;

    // Update verified status in Realtime Database
    await update(ref(database, `users/${uid}`), {
      emailVerified: true,
      emailVerifiedAt: Date.now()
    });

    showMessage(
      "অভিনন্দন! আপনার Email সফলভাবে যাচাই হয়েছে। AYNA BOOK খুলছে...",
      "success"
    );

    $("checkButton").textContent = "✅ যাচাই সম্পন্ন";

    setTimeout(() => {
      window.location.href = "profile.html";
    }, 1500);

  } catch (error) {
    console.error("Verification check error:", error);

    showMessage(
      "যাচাই সম্পন্ন করা যায়নি। ইন্টারনেট ও Firebase Database Rules পরীক্ষা করুন।",
      "error"
    );

  } finally {
    checking = false;
    updateButtons();
  }
});


// =========================================================
// RESEND VERIFICATION EMAIL
// =========================================================

$("resendButton")?.addEventListener("click", async () => {
  if (!currentUser || sending) {
    showMessage("আগে আপনার অ্যাকাউন্ট দিয়ে Login করুন।", "error");
    return;
  }

  sending = true;
  updateButtons();

  try {
    await reload(currentUser);

    if (currentUser.emailVerified) {
      showMessage(
        "আপনার ইমেইল ইতিমধ্যে যাচাই করা হয়েছে।",
        "success"
      );
      return;
    }

    await sendEmailVerification(currentUser);

    showMessage(
      `নতুন Verification Email পাঠানো হয়েছে: ${currentUser.email}। Inbox ও Spam ফোল্ডার দেখুন।`,
      "success"
    );

  } catch (error) {
    console.error("Resend verification error:", error);

    if (error.code === "auth/too-many-requests") {
      showMessage(
        "অনেকবার চেষ্টা হয়েছে। কিছুক্ষণ অপেক্ষা করে আবার চেষ্টা করুন।",
        "error"
      );
    } else {
      showMessage(
        "Verification Email পাঠানো যায়নি। Login session ও ইন্টারনেট পরীক্ষা করুন।",
        "error"
      );
    }

  } finally {
    sending = false;
    updateButtons();
  }
});


// =========================================================
// SIGN OUT
// =========================================================

$("logoutButton")?.addEventListener("click", async () => {
  try {
    await signOut(auth);

    showMessage(
      "আপনি Sign Out করেছেন। এখন Login পেজে যেতে পারেন।",
      "success"
    );

    setTimeout(() => {
      window.location.href = "login.html";
    }, 1000);

  } catch (error) {
    console.error("Sign out error:", error);
    showMessage("Sign Out করা যায়নি। আবার চেষ্টা করুন।", "error");
  }
});
