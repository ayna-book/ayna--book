
import {
  onAuthStateChanged,
  reload,
  sendEmailVerification,
  signOut
} from "https://www.gstatic.com/firebasejs/13.4.0/firebase-auth.js";

import {
  doc,
  updateDoc,
  serverTimestamp
} from "https://www.gstatic.com/firebasejs/13.4.0/firebase-firestore.js";

import { auth, db } from "./firebase-init.js";

const emailElement = document.getElementById("emailAddress");
const statusMessage = document.getElementById("statusMessage");
const checkButton = document.getElementById("checkButton");
const resendButton = document.getElementById("resendButton");
const loginButton = document.getElementById("loginButton");

let currentUser = null;
let checking = false;
let resendBusy = false;

function showMessage(message) {
  statusMessage.textContent = message;
}

async function activateVerifiedAccount(user) {
  // Refresh Firebase Authentication data.
  await reload(user);

  if (!user.emailVerified) {
    showMessage(
      "Your Gmail is not verified yet. Please check your inbox."
    );
    return false;
  }

  // Refresh ID token so Firestore Rules receive email_verified=true.
  await user.getIdToken(true);

  // Only update verification-related fields.
  await updateDoc(doc(db, "users", user.uid), {
    emailVerified: true,
    accountStatus: "active",
    updatedAt: serverTimestamp()
  });

  showMessage("Gmail verified successfully. Opening your profile...");

  location.href = "./profile.html";
  return true;
}

onAuthStateChanged(auth, async (user) => {
  currentUser = user;

  if (!user) {
    emailElement.textContent = "No active account";
    showMessage("Please log in to continue email verification.");
    checkButton.disabled = true;
    resendButton.disabled = true;
    return;
  }

  emailElement.textContent = user.email || "Email unavailable";

  checkButton.disabled = false;
  resendButton.disabled = false;

  if (user.emailVerified) {
    try {
      await activateVerifiedAccount(user);
    } catch (error) {
      showMessage(
        "Your Gmail is verified, but account activation failed. Please try again."
      );
      console.error("Account activation error:", error);
    }
  } else {
    showMessage(
      "Verification is pending. Please check your Gmail."
    );
  }
});

checkButton.addEventListener("click", async () => {
  if (!currentUser || checking) return;

  checking = true;
  checkButton.disabled = true;
  showMessage("Checking verification status...");

  try {
    await activateVerifiedAccount(currentUser);
  } catch (error) {
    console.error("Verification check error:", error);
    showMessage(
      "Unable to complete verification. Please try again."
    );
  } finally {
    checking = false;
    checkButton.disabled = !currentUser;
  }
});

resendButton.addEventListener("click", async () => {
  if (!currentUser || resendBusy) return;

  resendBusy = true;
  resendButton.disabled = true;

  try {
    await reload(currentUser);

    if (currentUser.emailVerified) {
      await activateVerifiedAccount(currentUser);
      return;
    }

    await sendEmailVerification(currentUser);

    showMessage(
      "A new verification email has been sent. Please check your inbox and spam folder."
    );
  } catch (error) {
    console.error("Resend verification error:", error);

    const messages = {
      "auth/too-many-requests":
        "Too many requests. Please wait before trying again.",
      "auth/network-request-failed":
        "Network error. Check your internet connection."
    };

    showMessage(
      messages[error.code] ||
      "Unable to send verification email. Please try again later."
    );
  } finally {
    resendBusy = false;
    resendButton.disabled = !currentUser;
  }
});

loginButton.addEventListener("click", async () => {
  try {
    if (auth.currentUser) {
      await signOut(auth);
    }
  } finally {
    location.href = "./login.html";
  }
});
