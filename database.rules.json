{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",

        ".write": "auth != null && auth.uid === $uid",

        ".validate": "newData.hasChildren(['uid', 'email', 'aynaId', 'createdAt'])",

        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },

        "email": {
          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 254"
        },

        "aynaId": {
          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 40"
        },

        "fullName": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 2 && newData.val().length <= 100)"
        },

        "phone": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 8 && newData.val().length <= 25)"
        },

        "country": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 2 && newData.val().length <= 100)"
        },

        "photoURL": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 700000)"
        },

        "photoMimeType": {
          ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'image/jpeg' || newData.val() === 'image/png' || newData.val() === 'image/webp'))"
        },

        "accountType": {
          ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'personal' || newData.val() === 'business' || newData.val() === 'vip' || newData.val() === 'vvip'))"
        },

        "plan": {
          ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'free' || newData.val() === 'business' || newData.val() === 'vip' || newData.val() === 'vvip'))"
        },

        "emailVerified": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },

        "emailVerifiedAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },

        "createdAt": {
          ".validate": "newData.isNumber()"
        },

        "updatedAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },

        "profileLocked": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },

        "status": {
          ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'active' || newData.val() === 'inactive' || newData.val() === 'pending' || newData.val() === 'suspended' || newData.val() === 'blocked'))"
        },

        "$other": {
          ".validate": false
        }
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "posts": {
      ".read": "auth != null",
      ".indexOn": [
        "uid",
        "createdAt"
      ],

      "$postId": {
        ".write": "auth != null && (!data.exists() ? newData.child('uid').val() === auth.uid : data.child('uid').val() === auth.uid)",

        ".validate": "newData.hasChildren(['uid', 'createdAt'])",

        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },

        "createdAt": {
          ".validate": "newData.isNumber()"
        },

        "$other": {
          ".validate": true
        }
      }
    },

    "messenger_rooms": {
      ".read": "auth != null",
      ".write": "auth != null",

      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "messages": {
      ".read": "auth != null",
      ".write": "auth != null",

      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null",

        "$messageId": {
          ".validate": "newData.hasChildren(['senderId', 'createdAt'])"
        }
      }
    },

    "typing": {
      "$chatId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}