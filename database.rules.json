{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        ".validate": "newData.hasChildren(['uid', 'aynaId', 'fullName', 'email', 'country', 'createdAt'])",

        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },

        "aynaId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },

        "fullName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
        },

        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },

        "country": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },

        "createdAt": {
          ".validate": "newData.isNumber()"
        },

        "$other": {
          ".validate": true
        }
      }
    },

    "posts": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$postId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "worldNgoHumanRights": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$orgId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}