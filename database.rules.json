{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        ".validate": "newData.hasChildren(['uid', 'email', 'aynaId', 'createdAt'])",

        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },

        "email": {
          ".validate": "newData.isString() && newData.val().length >= 5"
        },

        "phone": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 8)"
        },

        "fullName": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 2 && newData.val().length <= 100)"
        },

        "country": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)"
        },

        "bio": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)"
        },

        "photoURL": {
          ".validate": "!newData.exists() || newData.isString()"
        },

        "aynaId": {
          ".validate": "newData.isString() && newData.val().length >= 8"
        },

        "createdAt": {
          ".validate": "newData.isNumber()"
        },

        "accountType": {
          ".validate": "!newData.exists() || newData.isString()"
        },

        "plan": {
          ".validate": "!newData.exists() || newData.isString()"
        }
      }
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && newData.child('members').child(auth.uid).exists()",

        "members": {
          "$uid": {
            ".validate": "newData.val() === true"
          }
        }
      }
    },

    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",

        "$messageId": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",

          ".validate": "newData.hasChildren(['senderId', 'createdAt']) && newData.child('senderId').val() === auth.uid",

          "senderId": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },

          "text": {
            ".validate": "!newData.exists() || newData.isString()"
          },

          "type": {
            ".validate": "!newData.exists() || newData.isString()"
          },

          "createdAt": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },

    "typing": {
      "$chatId": {
        "$uid": {
          ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",

        ".validate": "newData.hasChildren(['online'])",

        "online": {
          ".validate": "newData.isBoolean()"
        },

        "lastChanged": {
          ".validate": "!newData.exists() || newData.isNumber()"
        }
      }
    }
  }
}