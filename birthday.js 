} from "https://www.gstatic.com/firebasejs/13.4.0/firebase-database.js";


// ============================================================
// GLOBAL
// ============================================================

let currentUser = null;
let birthdayUser = null;
let allUsers = {};
let friends = {};

const params = new URLSearchParams(location.search);

const targetUid =
  params.get("uid") ||
  params.get("userId") ||
  "";


// ============================================================
// DOM
// ============================================================

const loading =
  document.getElementById("loading");

const errorBox =
  document.getElementById("errorBox");

const personName =
  document.getElementById("personName");

const profilePhoto =
  document.getElementById("profilePhoto");

const birthdayDate =
  document.getElementById("birthdayDate");

const personStatus =
  document.getElementById("personStatus");

const shareLink =
  document.getElementById("shareLink");


// ============================================================
// AUTH
// ============================================================

onAuthStateChanged(auth, async (user) => {

  currentUser = user || null;

  try {

    // --------------------------------------------------------
    // If URL has UID, open that user's birthday page
    // --------------------------------------------------------

    if (targetUid) {

      await loadBirthdayUser(targetUid);

    }

    // --------------------------------------------------------
    // Otherwise logged-in user's birthday
    // --------------------------------------------------------

    else if (user) {

      await loadBirthdayUser(user.uid);

    }

    // --------------------------------------------------------
    // Not logged in
    // --------------------------------------------------------

    else {

      showDefaultBirthday();

    }

  } catch (error) {

    console.error(
      "AYNA Birthday Error:",
      error
    );

    showError(
      "জন্মদিনের তথ্য লোড করা যায়নি। Firebase RTDB Rules এবং users data পরীক্ষা করুন।"
    );

    showDefaultBirthday();

  }

});


// ============================================================
// LOAD BIRTHDAY USER
// ============================================================

async function loadBirthdayUser(uid) {

  const userRef =
    ref(
      database,
      "users/" + uid
    );

  const snapshot =
    await get(userRef);


  if (!snapshot.exists()) {

    showError(
      "এই বন্ধুর অ্যাকাউন্টের তথ্য পাওয়া যায়নি।"
    );

    showDefaultBirthday();

    return;

  }


  birthdayUser = {
    uid: uid,
    ...snapshot.val()
  };


  renderBirthdayUser();

}


// ============================================================
// RENDER USER
// ============================================================

function renderBirthdayUser() {

  const u =
    birthdayUser || {};


  const name =
    u.fullName ||
    u.name ||
    u.displayName ||
    "প্রিয় বন্ধু";


  const photo =
    u.photoURL ||
    u.photoUrl ||
    u.profilePhoto ||
    u.avatar ||
    createAvatar(name);


  if (personName) {

    personName.textContent =
      name;

  }


  if (profilePhoto) {

    profilePhoto.src =
      photo;

    profilePhoto.onerror =
      () => {

        profilePhoto.src =
          createAvatar(name);

      };

  }


  const birthday =
    getBirthdayValue(u);


  if (birthdayDate) {

    if (birthday) {

      birthdayDate.textContent =
        "🎂 জন্মদিন: " +
        formatDate(birthday);

    } else {

      birthdayDate.textContent =
        "🎂 শুভ জন্মদিন";

    }

  }


  if (personStatus) {

    if (isBirthdayToday(birthday)) {

      personStatus.textContent =
        "🎉 আজ আপনার বিশেষ দিন! 🌹";

    } else {

      personStatus.textContent =
        "🌹 AYNA BOOK ও বন্ধুদের পক্ষ থেকে রইল আন্তরিক শুভেচ্ছা।";

    }

  }


  if (shareLink) {

    shareLink.textContent =
      location.href;

  }


  hideLoading();

}


// ============================================================
// GET BIRTHDAY VALUE
// ============================================================

function getBirthdayValue(user) {

  if (!user) {
    return "";
  }


  return (
    user.birthday ||
    user.birthDate ||
    user.dateOfBirth ||
    user.dob ||
    ""
  );

}


// ============================================================
// CREATE AVATAR
// ============================================================

function createAvatar(name) {

  return (
    "https://ui-avatars.com/api/" +
    "?name=" +
    encodeURIComponent(name) +
    "&background=07152f" +
    "&color=FFD700" +
    "&size=600"
  );

}


// ============================================================
// DATE PARSER
// ============================================================

function parseBirthday(value) {

  if (!value) {
    return null;
  }


  // YYYY-MM-DD
  if (
    typeof value === "string" &&
    /^\d{4}-\d{1,2}-\d{1,2}$/.test(value)
  ) {

    const parts =
      value.split("-").map(Number);

    return {
      year: parts[0],
      month: parts[1],
      day: parts[2]
    };

  }


  // DD/MM/YYYY
  if (
    typeof value === "string" &&
    /^\d{1,2}\/\d{1,2}\/\d{4}$/.test(value)
  ) {

    const parts =
      value.split("/").map(Number);

    return {
      year: parts[2],
      month: parts[1],
      day: parts[0]
    };

  }


  // Date object / timestamp / other valid date
  const date =
    new Date(value);


  if (
    Number.isNaN(
      date.getTime()
    )
  ) {

    return null;

  }


  return {
    year: date.getFullYear(),
    month: date.getMonth() + 1,
    day: date.getDate()
  };

}


// ============================================================
// IS BIRTHDAY TODAY
// ============================================================

function isBirthdayToday(value) {

  const birthday =
    parseBirthday(value);

  if (!birthday) {
    return false;
  }


  const today =
    new Date();


  return (
    birthday.month ===
      today.getMonth() + 1
    &&
    birthday.day ===
      today.getDate()
  );

}


// ============================================================
// FORMAT DATE
// ============================================================

function formatDate(value) {

  const birthday =
    parseBirthday(value);


  if (!birthday) {

    return value || "";

  }


  try {

    const date =
      new Date(
        birthday.year,
        birthday.month - 1,
        birthday.day
      );


    return date.toLocaleDateString(
      "bn-BD",
      {
        year: "numeric",
        month: "long",
        day: "numeric"
      }
    );

  } catch {

    return value;

  }

}


// ============================================================
// TODAY'S BIRTHDAY
// ============================================================

export function checkTodayBirthday(user) {

  if (!user) {
    return false;
  }


  return isBirthdayToday(
    getBirthdayValue(user)
  );

}


// ============================================================
// LOAD ALL USERS
// ============================================================

export async function loadAllUsers() {

  const usersRef =
    ref(
      database,
      "users"
    );


  const snapshot =
    await get(usersRef);


  if (!snapshot.exists()) {

    return {};

  }


  allUsers =
    snapshot.val() || {};


  return allUsers;

}


// ============================================================
// FIND TODAY'S BIRTHDAYS
// ============================================================

export async function findTodayBirthdays() {

  const users =
    await loadAllUsers();


  const result = [];


  Object.entries(users)
    .forEach(
      ([uid, user]) => {

        const birthday =
          getBirthdayValue(user);


        if (
          birthday &&
          isBirthdayToday(birthday)
        ) {

          result.push({

            uid,

            ...user

          });

        }

      }
    );


  return result;

}


// ============================================================
// FIND UPCOMING BIRTHDAYS
// ============================================================

export async function findUpcomingBirthdays(
  days = 30
) {

  const users =
    await loadAllUsers();


  const today =
    new Date();

  today.setHours(
    0, 0, 0, 0
  );


  const result = [];


  Object.entries(users)
    .forEach(
      ([uid, user]) => {

        const birthday =
          parseBirthday(
            getBirthdayValue(user)
          );


        if (!birthday) {
          return;
        }


        let next =
          new Date(
            today.getFullYear(),
            birthday.month - 1,
            birthday.day
          );


        if (
          next < today
        ) {

          next =
            new Date(
              today.getFullYear() + 1,
              birthday.month - 1,
              birthday.day
            );

        }


        const diff =
          Math.ceil(
            (
              next.getTime() -
              today.getTime()
            )
            /
            86400000
          );


        if (
          diff >= 0 &&
          diff <= days
        ) {

          result.push({

            uid,

            ...user,

            daysUntil:
              diff,

            nextBirthday:
              next.getTime()

          });

        }

      }
    );


  result.sort(
    (a, b) =>
      a.daysUntil -
      b.daysUntil
  );


  return result;

}


// ============================================================
// LOAD FRIENDS
// ============================================================

export async function loadFriends() {

  if (!currentUser) {

    return {};

  }


  const friendRef =
    ref(
      database,
      "users/" +
      currentUser.uid +
      "/friends"
    );


  const snapshot =
    await get(friendRef);


  if (!snapshot.exists()) {

    friends = {};

    return {};

  }


  friends =
    snapshot.val() || {};


  return friends;

}


// ============================================================
// FIND FRIEND BIRTHDAYS
// ============================================================

export async function findFriendBirthdays() {

  if (!currentUser) {

    return [];

  }


  await loadFriends();


  const result = [];


  for (
    const friendUid
    of Object.keys(friends)
  ) {

    const userSnapshot =
      await get(
        ref(
          database,
          "users/" +
          friendUid
        )
      );


    if (
      !userSnapshot.exists()
    ) {

      continue;

    }


    const user =
      userSnapshot.val();


    const birthday =
      getBirthdayValue(user);


    if (
      birthday &&
      isBirthdayToday(birthday)
    ) {

      result.push({

        uid: friendUid,

        ...user

      });

    }

  }


  return result;

}


// ============================================================
// SAVE BIRTHDAY WISH
// ============================================================

export async function saveBirthdayWish({

  receiverUid,

  receiverName,

  message,

  senderName = ""

}) {

  if (!currentUser) {

    throw new Error(
      "LOGIN_REQUIRED"
    );

  }


  if (!receiverUid) {

    throw new Error(
      "RECEIVER_REQUIRED"
    );

  }


  if (!message) {

    throw new Error(
      "MESSAGE_REQUIRED"
    );

  }


  const wishesRef =
    ref(
      database,
      "birthdayWishes/" +
      receiverUid
    );


  const newWish =
    push(wishesRef);


  const data = {

    wishId:
      newWish.key,

    receiverUid,

    receiverName:
      receiverName || "",

    senderUid:
      currentUser.uid,

    senderName:
      senderName ||
      currentUser.displayName ||
      currentUser.email ||
      "AYNA BOOK User",

    senderEmail:
      currentUser.email ||
      "",

    message,

    createdAt:
      serverTimestamp(),

    type:
      "birthday"

  };


  await set(
    newWish,
    data
  );


  return newWish.key;

}


