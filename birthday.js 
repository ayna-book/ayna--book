window.sendCustomWish = async function () {

  const senderInput =
    document.getElementById(
      "senderName"
    );

  const messageInput =
    document.getElementById(
      "customMessage"
    );


  const sender =
    senderInput?.value.trim() ||
    currentUser?.displayName ||
    "একজন প্রিয় বন্ধু";


  const message =
    messageInput?.value.trim();


  const receiverUid =
    birthdayUser?.uid ||
    targetUid;


  const receiverName =
    birthdayUser?.fullName ||
    birthdayUser?.name ||
    birthdayUser?.displayName ||
    "প্রিয় বন্ধু";


  if (!message) {

    alert(
      "দয়া করে জন্মদিনের শুভেচ্ছা বার্তা লিখুন।"
    );

    return;

  }


  if (!receiverUid) {

    alert(
      "যার জন্মদিন তাকে নির্ধারণ করা যায়নি।"
    );

    return;

  }


  const finalMessage =
`🌹 শুভ জন্মদিন ${receiverName}! 🌹

${message}

— ${sender}

🌹 AYNA BOOK`;


  if (messageInput) {

    messageInput.value =
      finalMessage;

  }


  // ----------------------------------------------------------
  // Save to RTDB
  // ----------------------------------------------------------

  try {

    await saveBirthdayWish({

      receiverUid,

      receiverName,

      message:
        finalMessage,

      senderName:
        sender

    });


    alert(
      "🎉 আপনার জন্মদিনের শুভেচ্ছা সফলভাবে সংরক্ষণ হয়েছে।"
    );


  } catch (error) {

    console.error(
      "Birthday wish save error:",
      error
    );


    if (
      error.message ===
      "LOGIN_REQUIRED"
    ) {

      alert(
        "শুভেচ্ছা সংরক্ষণ করতে আগে Login করুন।"
      );

    } else {

      alert(
        "বার্তাটি তৈরি হয়েছে, কিন্তু Firebase-এ সংরক্ষণ করা যায়নি। RTDB Rules পরীক্ষা করুন।"
      );

    }

  }

};


// ============================================================
// COPY WISH
// ============================================================

window.copyWish = async function () {

  const messageInput =
    document.getElementById(
      "customMessage"
    );


  const text =
    messageInput?.value.trim();


  if (!text) {

    alert(
      "আগে একটি শুভেচ্ছা বার্তা লিখুন।"
    );

    return;

  }


  try {

    await navigator.clipboard.writeText(
      text
    );


    alert(
      "🌹 শুভেচ্ছা বার্তাটি কপি হয়েছে।"
    );

  } catch {

    // Fallback
    if (messageInput) {

      messageInput.select();

      document.execCommand(
        "copy"
      );

      alert(
        "🌹 শুভেচ্ছা বার্তাটি কপি হয়েছে।"
      );

    }

  }

};


// ============================================================
// SHARE BIRTHDAY
