window.shareBirthday = async function () {

  const name =
    birthdayUser?.fullName ||
    birthdayUser?.name ||
    birthdayUser?.displayName ||
    "প্রিয় বন্ধু";


  const text =
`🌹 শুভ জন্মদিন ${name}! 🌹

AYNA BOOK পরিবারের পক্ষ থেকে
রইল একগুচ্ছ গোলাপ ও আন্তরিক শুভেচ্ছা।

🎂 ${location.href}`;


  if (
    navigator.share
  ) {

    try {

      await navigator.share({

        title:
          `শুভ জন্মদিন — ${name}`,

        text,

        url:
          location.href

      });

      return;

    } catch (error) {

      console.log(
        "Share cancelled:",
        error
      );

    }

  }


  try {

    await navigator.clipboard.writeText(
      text
    );


    alert(
      "জন্মদিনের শুভেচ্ছাটি কপি হয়েছে। এখন শেয়ার করতে পারেন।"
    );

  } catch {

    alert(text);

  }

};


