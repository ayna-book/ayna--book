<!-- OTP BOX -->
<div id="otpSection" class="otp-panel" hidden>
  <h3><i class="fa-solid fa-shield-halved"></i>
    OTP Verification</h3>
  <p id="otpMessage" class="muted">
    আপনার ফোনে পাঠানো ৬ সংখ্যার OTP লিখুন।
  </p>

  <label for="otpCode">6-Digit OTP</label>
  <input type="text" id="otpCode"
    inputmode="numeric" autocomplete="one-time-code"
    maxlength="6" pattern="[0-9]{6}"
    placeholder="Enter 6-digit OTP">

  <div id="recaptcha-container"></div>

  <button class="btn primary full-width"
    id="verifyOtpBtn" type="button">
    Verify OTP & Create Account
  </button>

  <button class="btn secondary full-width"
    id="resendOtpBtn" type="button">
    Resend OTP
  </button>

  <p id="otpStatus" class="status"></p>
</div>